[package]
name = "native-bridge-joined-native"
version = "0.1.0"
edition = "2021"
[workspace]
[dependencies]
reth-unicity-execution = { path = @EXECUTION_PATH@, features = ["test-utils"] }
reth-unicity-b1 = { path = @B1_PATH@ }
sha2 = "=0.10.9"
alloy-evm = { version = "=0.38.0", default-features = false }
alloy-primitives = { version = "=1.6.1", default-features = false, features = ["std", "map-foldhash"] }
alloy-sol-types = { version = "=1.6.1", default-features = false, features = ["std"] }
revm = { version = "=42.0.1", default-features = false, features = ["std"] }
serde_json = "=1.0.150"
